{
    "headers": [
		{
			"source": "/assets/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=0, must-revalidate"
				}
			]
		},
		{
			"source": "/manifest.webmanifest",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=3600, stale-while-revalidate=86400"
				}
			]
		}
	],
    "github": {
		"silent": true
	}
}
